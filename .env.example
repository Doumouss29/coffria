NODE_ENV=production

# Base PostgreSQL managée (OVH, Scaleway, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/coffria?schema=public&sslmode=require"

REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h

NEXT_PUBLIC_API_URL=http://SERVER_IP:4000/api
APP_URL=http://SERVER_IP:3000
API_PORT=4000
WEB_PORT=3000

S3_BUCKET=coffria-production
S3_REGION=fr-par
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_TTL_SECONDS=3600

DEFAULT_MAX_FILE_SIZE_BYTES=5368709120
INVITATION_TTL_HOURS=168
TRASH_RETENTION_DAYS=30

# Uniquement pour initialiser les comptes de démonstration.
SEED_PASSWORD=replace-with-a-strong-temporary-password
