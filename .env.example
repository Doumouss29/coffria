NODE_ENV=production

# PostgreSQL Coffria
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/coffria?schema=public"

REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=8h

NEXT_PUBLIC_API_URL=https://coffria.ci/api
APP_URL=https://coffria.ci
API_PORT=4000
WEB_PORT=3000

S3_BUCKET=coffria-production
S3_REGION=fr-par
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGNED_TTL_SECONDS=3600

# Formulaire de contact et invitations de signature via Brevo SMTP
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
CONTACT_TO_EMAIL=contact.lmurbs@gmail.com
CONTACT_FROM_EMAIL=contact@coffria.ci
CONTACT_FROM_NAME=Coffria

# Assistant IA local. Laisser vide tant que le service Ollama n'est pas démarré.
OLLAMA_BASE_URL=http://coffria-ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text

DEFAULT_MAX_FILE_SIZE_BYTES=5368709120
INVITATION_TTL_HOURS=168
TRASH_RETENTION_DAYS=30

# Uniquement pour initialiser les comptes de démonstration.
SEED_PASSWORD=replace-with-a-strong-temporary-password
