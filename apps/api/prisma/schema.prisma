generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  SUPER_ADMIN
  TENANT_ADMIN
  EDITOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum MfaMethod {
  TOTP
  EMAIL
}

enum FolderVisibility {
  COMPANY
  PRIVATE
  RESTRICTED
}

enum FolderSpace {
  COMPANY
  PERSONAL
}

enum DocumentStatus {
  PENDING_UPLOAD
  ACTIVE
  QUARANTINED
  TRASHED
}

enum SignatureRequestStatus {
  DRAFT
  PENDING
  PARTIALLY_SIGNED
  COMPLETED
  REFUSED
  EXPIRED
  CANCELLED
}

enum SignatureRecipientStatus {
  PENDING
  VIEWED
  SIGNED
  REFUSED
}

model Tenant {
  id                    String   @id @default(uuid())
  name                  String
  slug                  String   @unique
  storageQuotaBytes     BigInt   @default(107374182400)
  maxUsers              Int      @default(10)
  maxFileSizeBytes      BigInt   @default(5368709120)
  active                Boolean  @default(true)
  signatureEnabled      Boolean  @default(true)
  signatureUsageLimit   Int?
  signatureUsageUsed    Int      @default(0)
  subscriptionExpiresAt DateTime?
  mfaAllowTotp          Boolean  @default(true)
  mfaAllowEmail         Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users             User[]
  folders           Folder[]
  documents         Document[]
  invitations       Invitation[]
  auditLogs         AuditLog[]
  groups            Group[]
  signatureRequests SignatureRequest[]
  archiveChunks     ArchiveChunk[]
}

model User {
  id                 String       @id @default(uuid())
  tenantId           String?
  tenant             Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name               String
  email              String       @unique
  passwordHash       String
  role               PlatformRole
  status             UserStatus   @default(ACTIVE)
  mfaEnabled         Boolean      @default(false)
  mfaMethod          MfaMethod?
  mfaSecretEncrypted String?
  mfaRecoveryCodes   Json         @default("[]")
  mfaConfiguredAt    DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  foldersCreated       Folder[]            @relation("FolderCreator")
  docsCreated          Document[]          @relation("DocumentCreator")
  invitations          Invitation[]        @relation("InvitationCreator")
  auditLogs            AuditLog[]
  groupMemberships     GroupMember[]
  folderAccesses       FolderUserAccess[]
  signatureRequests    SignatureRequest[]  @relation("SignatureRequestCreator")
  mfaEmailChallenges   MfaEmailChallenge[]
  trustedDevices       TrustedDevice[]
}

model MfaEmailChallenge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, purpose, createdAt])
}

model TrustedDevice {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  label      String?
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
}

model Folder {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentId    String?
  parent      Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Folder[] @relation("FolderTree")
  name        String
  createdById String
  createdBy   User     @relation("FolderCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  visibility  FolderVisibility @default(COMPANY)
  space       FolderSpace      @default(COMPANY)

  documents     Document[]
  userAccesses  FolderUserAccess[]
  groupAccesses FolderGroupAccess[]

  @@index([tenantId, parentId, deletedAt])
  @@index([tenantId, space, parentId, deletedAt])
  @@unique([tenantId, space, parentId, name])
}

model Group {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        GroupMember[]
  folderAccesses FolderGroupAccess[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model GroupMember {
  groupId String
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

model FolderUserAccess {
  folderId String
  folder   Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([folderId, userId])
  @@index([userId])
}

model FolderGroupAccess {
  folderId String
  folder   Folder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  groupId  String
  group    Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([folderId, groupId])
  @@index([groupId])
}

model Document {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folderId        String
  folder          Folder         @relation(fields: [folderId], references: [id], onDelete: Cascade)
  technicalNumber String         @unique
  name            String
  extension       String?
  mimeType        String
  sizeBytes       BigInt
  storageKey      String         @unique
  checksumSha256  String?
  version         Int            @default(1)
  status          DocumentStatus @default(PENDING_UPLOAD)
  metadata        Json           @default("{}")
  extractedText   String?
  createdById     String
  createdBy       User           @relation("DocumentCreator", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  archiveChunks           ArchiveChunk[]
  signatureSourceRequests SignatureRequest[] @relation("SignatureSourceDocument")
  signatureFinalRequests  SignatureRequest[] @relation("SignatureFinalDocument")

  @@index([tenantId, folderId, status, deletedAt])
  @@index([tenantId, name])
}

model ArchiveChunk {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page       Int?
  position   Int
  content    String
  embedding  Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, documentId])
  @@index([tenantId, position])
}

model SignatureRequest {
  id                String                 @id @default(uuid())
  tenantId          String
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceDocumentId  String
  sourceDocument    Document               @relation("SignatureSourceDocument", fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  finalDocumentId   String?
  finalDocument     Document?              @relation("SignatureFinalDocument", fields: [finalDocumentId], references: [id], onDelete: SetNull)
  createdById       String
  createdBy         User                   @relation("SignatureRequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  title             String
  message           String?
  status            SignatureRequestStatus @default(DRAFT)
  currentStorageKey String
  expiresAt         DateTime?
  completedAt       DateTime?
  deletedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  recipients        SignatureRecipient[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, deletedAt])
}

model SignatureRecipient {
  id            String                   @id @default(uuid())
  requestId     String
  request       SignatureRequest         @relation(fields: [requestId], references: [id], onDelete: Cascade)
  name          String
  email         String
  order         Int
  tokenHash     String                   @unique
  status        SignatureRecipientStatus @default(PENDING)
  viewedAt      DateTime?
  signedAt      DateTime?
  refusedAt     DateTime?
  ipAddress     String?
  userAgent     String?
  signatureText String?
  evidence      Json                     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([requestId, order])
  @@index([requestId, status])
}

model Invitation {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  role        PlatformRole
  tokenHash   String       @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdBy   User         @relation("InvitationCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

model MarketingOffer {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?
  description String
  ctaLabel    String   @default("Découvrir l'offre")
  ctaUrl      String   @default("/contact")
  placement   String   @default("BOTH")
  startAt     DateTime?
  endAt       DateTime?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model PricingPlan {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  subtitle           String?
  priceLabel         String   @default("Sur devis")
  monthlyPriceCents  Int?
  yearlyPriceCents   Int?
  storageGb          Int?
  maxUsers           Int?
  features           Json     @default("[]")
  badge              String?
  isHighlighted      Boolean  @default(false)
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, sortOrder])
}
